generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model creature {
  guid         Int   @id @default(autoincrement())
  id1          Int   @default(0)
  map          Int   @default(0)
  position_x   Float @default(0)
  position_y   Float @default(0)
  position_z   Float @default(0)
  orientation  Float @default(0)
  phaseMask    Int   @default(1)
  curhealth    Int   @default(1)
  curmana      Int   @default(0)

  @@index([id1])
  @@index([map])
}

model creature_template {
  entry       Int     @id @default(0)
  name        String  @default("0")
  subname     String?
  maxlevel    Int     @default(1)
  flags_extra Int     @default(0)

  @@index([name])
}

model creature_equip_template {
  CreatureID Int @default(0)
  ID         Int @default(1)
  ItemID1    Int @default(0)
  ItemID2    Int @default(0)
  ItemID3    Int @default(0)

  @@id([CreatureID, ID])
}

model creature_template_model {
  CreatureID        Int
  Idx               Int   @default(0)
  CreatureDisplayID Int
  DisplayScale      Float @default(1)

  @@id([CreatureID, Idx])
}

model item_template {
  entry         Int @id @default(0)
  InventoryType Int @default(0)

  @@index([InventoryType])
}
