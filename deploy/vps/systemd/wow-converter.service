[Unit]
Description=wow-converter (Go bundled)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/wow-converter/dist-go
EnvironmentFile=-/root/wow-converter/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=WOW_CONVERTER_BUNDLED=1
ExecStart=/root/wow-hosting/scripts/run-wowconverter.sh
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
