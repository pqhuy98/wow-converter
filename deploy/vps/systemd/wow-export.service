[Unit]
Description=wow.export (NW.js + Xvfb)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/wow-converter/wow.export/bin/linux-x64
Environment=PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/root/wow-hosting/scripts/run-wowexport.sh
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
