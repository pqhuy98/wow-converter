[Unit]
Description=wow-data-server (native WoW reader REST)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/wow-converter
EnvironmentFile=-/root/wow-converter/.env
Environment=PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/root/wow-hosting/scripts/run-wow-data-server.sh
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
