{
  "name": "@pqhuy98/wow-converter",
  "version": "1.1.0",
  "description": "",
  "author": "Huy Pham",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts --fix && cd webui && bun run lint",
    "dev": "bun scripts/dev.ts",
    "build": "cd webui && bun run build && cd .. && powershell -ExecutionPolicy Bypass -File scripts/build-go-app.ps1",
    "build:linux": "cd webui && bun run build && cd .. && bash scripts/build-go-app.sh",
    "test:unit": "cd golang && go test ./... && cd .. && bun test webui scripts tests/wc3-map-formats.test.ts golang/internal/server/reportshot/wowhead-sample.test.js",
    "test:snapshot": "bun test --max-concurrency=1 tests/snapshot-tests",
    "test:snapshot-update": "SNAPSHOT_UPDATE=1 bun test --max-concurrency=1 tests/snapshot-tests",
    "test:api": "bun test tests/api-tests",
    "test:regression-maps": "bun test --max-concurrency=1 tests/regression-maps",
    "test:regression-maps:fresh": "fresh=1 bun test --max-concurrency=1 tests/regression-maps",
    "test:golang-integration": "bun test --max-concurrency=1 tests/golang-integration-tests",
    "verify": "bun scripts/verify.ts",
    "generate:acore-sqlite": "bun scripts/generate-azerothcore-sqlite.ts",
    "shot": "go -C golang run ./cmd/shot-converter",
    "postinstall": "cd webui && bun install"
  },
  "devDependencies": {
    "@pqhuy98/mdx-m3-viewer": "^5.13.1",
    "@stylistic/eslint-plugin-ts": "^2.13.0",
    "@types/bun": "^1.3.14",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.18.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "mysql2": "^3.22.5",
    "pg": "^8.21.0",
    "typescript": "^5.9.3",
    "upscayl-node": "^3.1.1"
  },
  "dependencies": {
    "fs-extra": "^11.3.2",
    "ieee754": "^1.2.1",
    "image-q": "^4.0.0",
    "intn": "^1.0.0",
    "sharp": "^0.34.4"
  }
}
