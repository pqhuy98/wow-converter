{
  "name": "@pqhuy98/wow-converter",
  "version": "1.1.0",
  "description": "",
  "author": "Huy Pham",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts --fix",
    "kill:dev-ports": "bun scripts/kill-dev-ports.ts",
    "dev:run": "run-p dev:server dev:webui dev:wow-data-server",
    "dev": "run-s kill:dev-ports dev:run",
    "dev:server": "cross-env NODE_ENV=development bun --watch src/server/index.ts",
    "dev:wow-data-server": "bun --watch src/wow-data-server/index.ts",
    "dev:go-data-server": "cd golang && go run ./cmd/wow-data-server",
    "parity:servers": "bun scripts/start-parity-servers.ts",
    "debug:mdl-parity": "bun scripts/retail-mdl-parity-loop.ts --debug",
    "parity:retail-mdl-loop": "bun scripts/retail-mdl-parity-loop.ts",
    "parity:random-mdl-loop": "bun scripts/retail-mdl-parity-loop.ts --random-mdl",
    "dev:go-converter": "cd golang && cross-env NODE_ENV=development go tool air",
    "dev:go": "npm-run-all kill:dev-ports --parallel dev:go-data-server dev:go-converter dev:webui",
    "build:go-app": "run-s build:webui build:go-app:bundle",
    "build:go-app:bundle": "powershell -ExecutionPolicy Bypass -File scripts/build-go-app.ps1 -SkipWebUI",
    "parity:mount-mdl-loop": "bun scripts/mount-mdl-parity-loop.ts",
    "test:go": "cd golang && go test ./...",
    "test:go:integration": "cd golang && go test -tags=integration ./test/integration/...",
    "test:go:bench": "cd golang && go test -bench=. -benchmem ./test/bench/...",
    "dev:webui": "cd webui && bun run dev",
    "wow-data-server": "bun src/wow-data-server/index.ts",
    "start": "set NODE_ENV=production && bun src/server/index.ts",
    "test": "bun tests/index.ts",
    "test:fresh": "bun tests/index.ts --fresh",
    "prisma:generate": "prisma generate",
    "generate:acore-sqlite": "bun scripts/generate-azerothcore-sqlite.ts",
    "verify:acore-sqlite": "bun scripts/verify-acore-sqlite.ts",
    "clean": "bun scripts/clean.ts",
    "install:webui": "cd webui && bun install",
    "postinstall": "run-p install:webui prisma:generate",
    "build:webui": "cd webui && bun run build",
    "build:bun": "bun build --compile --compile-autoload-package-json --no-compile-autoload-dotenv src/app/index.ts --outfile ./dist/wow-converter.exe --external sharp image-q upscayl-node fs-extra --windows-title \"wow-converter\" --windows-publisher \"Huy\" --env=disable",
    "build:blp-worker": "bun build src/lib/formats/blp/blp.worker.ts --outfile dist/blp.worker.js --target=bun --minify",
    "build:blp-native": "powershell -ExecutionPolicy Bypass -File scripts/build-blp-native.ps1",
    "setup:upscayl-native": "powershell -ExecutionPolicy Bypass -File scripts/setup-upscayl-native.ps1",
    "build:copy": "shx rm -rf dist/webui dist/bin dist/node_modules dist/resources && cross-env mkdir dist/webui && shx cp -r webui/out dist/webui && shx cp -r bin dist/bin && shx cp -r resources dist/resources && shx cp -r maps/template-empty.w3x dist/resources/template-empty.w3x && shx cp src/lib/formats/blp/blp.worker.ts dist/ && run-s build:blp-worker && npm i --omit=dev --prefix dist --no-audit --no-fund --include=optional sharp@^0.34.4 image-q@^4.0.0 upscayl-node@^3.1.1 fs-extra@^11.3.2",
    "zip": "powershell -Command \"Compress-Archive -Path dist\\* -DestinationPath wow-converter.zip -Force\"",
    "build:app": "run-p build:webui build:bun && run-s build:copy zip",
    "build:server": "bun run clean && run-p build:webui",
    "build": "bun run clean && bun run build:app",
    "smoke:bundle": "bun scripts/smoke-test-bundle.ts",
    "build:blp:win": "cd node-images-blp && npx node-gyp rebuild && shx cp build/Release/binding.node ../bin/blp-preview/win32-x64-binding.node",
    "build:blp:linux": "cd node-images-blp && npx node-gyp rebuild && cp build/Release/binding.node ../bin/blp-preview/linux-x64-binding.node"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-ts": "^2.13.0",
    "@types/archiver": "^6.0.3",
    "@types/assert": "^1.5.11",
    "@types/bun": "^1.3.14",
    "@types/chalk": "^2.2.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-http-proxy": "^1.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/http-proxy": "^1.17.16",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.18.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "es-main": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "express-http-proxy": "^2.1.2",
    "http-proxy": "^1.18.1",
    "mysql2": "^3.22.5",
    "npm": "^11.6.1",
    "npm-run-all": "^4.1.5",
    "pg": "^8.21.0",
    "prisma": "^6.16.3",
    "shx": "^0.4.0",
    "tsc-alias": "^1.8.16"
  },
  "dependencies": {
    "@pqhuy98/mdx-m3-viewer": "^5.13.1",
    "@prisma/client": "^6.16.3",
    "archiver": "^7.0.1",
    "assert": "^2.1.0",
    "axios": "^1.12.2",
    "chalk": "^4.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "helmet": "^8.1.0",
    "ieee754": "^1.2.1",
    "image-q": "^4.0.0",
    "intn": "^1.0.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.2",
    "round-to": "^6.0.0",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "upscayl-node": "^3.1.1",
    "war3-model": "^4.0.0",
    "zod": "^4.1.11"
  }
}
