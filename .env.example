# Copy to .env and adjust paths for your machine.

DATABASE_URL="file:../bin/azerothcore-world.sqlite"

# Live AzerothCore world DB — only used by `bun run generate:acore-sqlite`.
# Default in the script is mysql://acore:acore@127.0.0.1:3306/acore_world (WSL MySQL).
ACORE_SOURCE_DATABASE_URL="mysql://acore:acore@127.0.0.1:3306/acore_world"

NODE_ENV=development
WOW_DATA_SERVER_PORT=17753
# Local WoW install (web UI skips setup wizard when set)
CASC_LOCAL_WOW="D:\\Programs\\Blizzard Games\\World of Warcraft"
CASC_LOCAL_PRODUCT=wow

# Remote CASC fallback
# CASC_REMOTE_REGION=eu
# CASC_REMOTE_PRODUCT=wow

# Optional remote wow-data-server
# WOW_DATA_SERVER_URL='https://wow.quangdel.com:27753'
