{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": [
      "es2022"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": ["src", "tests", "scripts", "bun-env.d.ts"],
  "exclude": ["webui"]
}
